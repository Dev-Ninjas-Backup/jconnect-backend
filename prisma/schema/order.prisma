enum OrderStatus {
  PENDING
  IN_PROGRESS
  PROOF_SUBMITTED
  RESUBMIT
  CANCELLED
  RELEASED
}

model Order {
  id                   String      @id @default(uuid())
  orderCode            String      @unique
  amount               Int
  seller_amount        Int         @default(0)
  PlatfromRevinue      Int         @default(0)
  stripeFee            Int         @default(0)
  status               OrderStatus @default(PENDING)
  buyerId              String
  sessionId            String?     @unique() // Stripe Checkout Session ID
  sellerId             String
  sellerIdStripe       String?
  serviceId            String
  serviceRequestId     String?
  paymentIntentId      String?     @unique // Stripe Payment Intent ID
  buyerPay             Int         @default(0)
  platformFee          Int
  platformFee_percents Int         @default(0)
  deliveryDate         DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  inProgressAt         DateTime?
  cancelledAt          DateTime?
  disposts             Dispute[]
  // For Escrow Manual Release
  isReleased           Boolean     @default(false)
  releasedAt           DateTime?

  //                   Auto-expiry deadlines (mirrors RepostOrder's countdownEndsAt/reviewWindowEndsAt)

  // Seller must move the order to IN_PROGRESS before this (12h from order creation),
  // else it's auto-cancelled and refunded.
  acceptDeadline      DateTime?
  // Seller must submit proof before this (24h after accepting), else it's auto-cancelled and refunded.
  proofSubmitDeadline DateTime?
  // Buyer must review submitted proof before this, else funds are auto-released to the seller.
  proofReviewDeadline DateTime?

  //                   Proof

  proofUrl               String[]
  proofSubmittedAt       DateTime?
  resubmitAt             DateTime?
  isCancalProofSubmitted Boolean  @default(false)
  proofRejectReason      String?  // Buyer's reason when rejecting submitted proof

  //                   Cancellation Request (buyer requests cancel while order is in progress)

  isCancelRequested Boolean   @default(false)
  cancelRequestedAt DateTime?

  //                   Relations
  buyer          User            @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller         User            @relation("OrderSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  service        Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)

  @@index([status, acceptDeadline])
  @@index([status, proofSubmitDeadline])
  @@index([status, proofReviewDeadline])
}
